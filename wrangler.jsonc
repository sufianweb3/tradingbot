{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oi-sniper",
  "main": "cf/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "EngineV3DO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EngineDO"] },
    { "tag": "v2", "new_sqlite_classes": ["EngineV2DO"] },
    { "tag": "v3", "deleted_classes": ["EngineDO"] },
    { "tag": "v4", "new_sqlite_classes": ["EngineV3DO"] }
  ],
  "observability": { "enabled": true }
}
